{
    "name": "support-bot/telegram-bot",
    "description": "Telegram Support Bot with OOP architecture",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "monolog/monolog": "^3.5",
        "symfony/console": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4",
        "telegram-bot/api": "dev-master",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
