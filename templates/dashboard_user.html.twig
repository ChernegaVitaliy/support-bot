{% extends 'base.html.twig' %}

{% block title %}Головна{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Головна</h1>
        <div class="header-icon"><i data-lucide="home"></i></div>
    </div>

    <div class="hero">
        <div class="hero-avatar">
            {% if app_user.photo_url is defined and app_user.photo_url %}
                <img src="{{ app_user.photo_url }}" alt="" />
            {% else %}
                <i data-lucide="user"></i>
            {% endif %}
        </div>
        <h2 class="hero-name">{{ app_user.first_name|default(app_user.username|default('Користувач')) }}</h2>
        <div class="hero-username">@{{ app_user.username|default('—') }}</div>
    </div>

    <a href="{{ path('miniapp_report_new') }}" class="list-item">
        <div class="item-icon"><i data-lucide="plus-circle"></i></div>
        <div class="item-body">
            <div class="item-title">Створити репорт</div>
            <div class="item-sub">Поскаржитися на порушення</div>
        </div>
        <i data-lucide="chevron-right" class="item-chevron icon-sm"></i>
    </a>

    <a href="{{ path('miniapp_reports') }}" class="list-item">
        <div class="item-icon"><i data-lucide="flag"></i></div>
        <div class="item-body">
            <div class="item-title">Мої репорти</div>
            <div class="item-sub">Переглянути статус скарг</div>
        </div>
        <i data-lucide="chevron-right" class="item-chevron icon-sm"></i>
    </a>

    <h2 class="section-title">Останні репорти</h2>

    {% import 'macros.html.twig' as m %}
    {% for report in my_reports %}
        {{ m.reportCard(report, false, path('miniapp_report_detail', {id: report.id})) }}
    {% else %}
        <div class="empty">
            <i data-lucide="inbox"></i>
            <div class="empty-text">Репортів ще немає</div>
        </div>
    {% endfor %}
{% endblock %}
