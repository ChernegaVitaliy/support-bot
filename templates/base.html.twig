<!doctype html>
<html lang="uk">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no" />
    <title>{% block title %}Support{% endblock %}</title>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <link rel="stylesheet" href="/css/index.css?v={{ random() }}">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body data-route="{{ app.request.attributes.get('_route') }}">
    <main id="main-content" class="app-main">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash{% if label == 'error' %} error{% endif %}">
                    <i data-lucide="{% if label == 'error' %}alert-triangle{% else %}check-circle{% endif %}" class="icon-sm"></i>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    {% block tabbar %}
    {% set current_route = app.request.attributes.get('_route') %}
    <nav class="tabbar">
        <a href="{{ path('miniapp_index') }}" class="tab{% if current_route == 'miniapp_index' %} active{% endif %}">
            <i data-lucide="home"></i>
            <span>Головна</span>
        </a>
        <a href="{{ path('miniapp_report_new') }}" class="tab{% if current_route == 'miniapp_report_new' %} active{% endif %}">
            <i data-lucide="plus-circle"></i>
            <span>Репорт</span>
        </a>
        <a href="{{ path('miniapp_reports') }}" class="tab{% if current_route starts with 'miniapp_reports' or current_route starts with 'miniapp_report_detail' %} active{% endif %}">
            <i data-lucide="flag"></i>
            <span>Репорти</span>
        </a>
        {% if is_admin %}
        <a href="{{ path('miniapp_admin') }}" class="tab{% if current_route == 'miniapp_admin' or current_route == 'miniapp_ranks' %} active{% endif %}">
            <i data-lucide="shield"></i>
            <span>Адмін</span>
        </a>
        {% endif %}
        <a href="{{ path('miniapp_profile') }}" class="tab{% if current_route == 'miniapp_profile' %} active{% endif %}">
            <i data-lucide="user"></i>
            <span>Профіль</span>
        </a>
    </nav>
    {% endblock %}

    <script src="/js/app.js?v={{ random() }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
