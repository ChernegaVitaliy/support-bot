{% macro statusBadge(status) %}
    {% set map = {
        'pending':  {'icon': 'clock',       'label': 'Очікує',    'cls': 'badge-pending'},
        'accepted': {'icon': 'check-circle','label': 'Прийнято',  'cls': 'badge-accepted'},
        'rejected': {'icon': 'x-circle',    'label': 'Відхилено', 'cls': 'badge-rejected'}
    } %}
    {% set info = map[status] ?? map['pending'] %}
    <span class="badge {{ info.cls }}">
        <i data-lucide="{{ info.icon }}" class="icon-sm"></i>{{ info.label }}
    </span>
{% endmacro %}

{% macro reportCard(report, canProcess, detailPath) %}
    <a href="{{ detailPath }}" class="report-card">
        <div class="report-head">
            <div class="report-id">
                <i data-lucide="hash" class="icon-sm"></i>{{ report.id }}
            </div>
            {{ _self.statusBadge(report.status) }}
        </div>
        <div class="report-row">
            <span class="muted-label">Скаржник:</span> <code class="code">{{ report.reporter_nick }}</code>
        </div>
        <div class="report-row">
            <span class="muted-label">Порушник:</span> <code class="code">{{ report.reported_nick }}</code>
        </div>
        <div class="report-row">
            <span class="muted-label">Причина:</span> {{ report.reason }}
        </div>
        <div class="report-meta">
            <i data-lucide="calendar" class="icon-sm"></i>
            {{ report.created_at|date('d.m.Y H:i') }}
            {% if report.proof_type != 'text' %}
                <span class="media-tag"><i data-lucide="paperclip" class="icon-sm"></i>Медіа</span>
            {% endif %}
        </div>
    </a>
{% endmacro %}
