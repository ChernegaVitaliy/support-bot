{% extends 'base.html.twig' %}

{% block title %}Мої репорти{% endblock %}

{% block body %}
    <a href="{{ path('miniapp_index') }}" class="back-link">
        <i data-lucide="arrow-left" class="icon-sm"></i> Назад
    </a>

    <div class="page-header">
        <h1 class="page-title">Мої репорти</h1>
    </div>

    {% import 'macros.html.twig' as m %}
    {% for report in reports %}
        {{ m.reportCard(report, false, path('miniapp_report_detail', {id: report.id})) }}
    {% else %}
        <div class="empty">
            <i data-lucide="inbox"></i>
            <div class="empty-text">Репортів ще немає</div>
        </div>
    {% endfor %}
{% endblock %}
