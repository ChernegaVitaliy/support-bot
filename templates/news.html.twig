{% extends 'base.html.twig' %}

{% block title %}Новини{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Новини</h1>
        {% if can_create_news %}
        <a href="{{ path('miniapp_news_new') }}" class="btn btn-primary btn-icon">
            <i data-lucide="plus" class="icon-sm"></i>Створити
        </a>
        {% endif %}
    </div>

    {% for item in news_items %}
        <a href="{{ path('miniapp_news_detail', {id: item.id}) }}" class="news-card" data-news-id="{{ item.id }}">
            <div class="news-header">
                <h2 class="news-title">{{ item.title }}</h2>
                <span class="news-date">
                    <i data-lucide="calendar" class="icon-sm"></i>
                    {{ item.created_at|date('d.m.Y H:i') }}
                </span>
            </div>
            <div class="news-body">{{ item.body }}</div>
            <div class="news-footer">
                <span class="news-author">
                    <i data-lucide="user" class="icon-sm"></i>
                    {{ item.author_first_name|default(item.author_username|default('—')) }}
                </span>
            </div>
        </a>
    {% else %}
        <div class="empty">
            <i data-lucide="inbox"></i>
            <div class="empty-text">Новин ще немає</div>
        </div>
    {% endfor %}

    {% if news_items %}
    <button type="button" class="btn btn-ghost btn-block" id="mark-all-read" style="display:none">
        <i data-lucide="check-check" class="icon-sm"></i>Прочитати все
    </button>
    {% endif %}
{% endblock %}

{% block javascripts %}
<script>
(function () {
    try {
        var total = document.querySelectorAll('[data-news-id]').length;
        localStorage.setItem('news_total', String(total));

        var read = JSON.parse(localStorage.getItem('news_read') || '[]');
        var hasUnread = false;
        document.querySelectorAll('[data-news-id]').forEach(function (card) {
            if (read.indexOf(card.getAttribute('data-news-id')) !== -1) {
                card.classList.add('read');
            } else {
                hasUnread = true;
            }
        });

        var btn = document.getElementById('mark-all-read');
        if (btn && hasUnread) {
            btn.style.display = '';
            btn.addEventListener('click', function () {
                var ids = [];
                document.querySelectorAll('[data-news-id]').forEach(function (card) {
                    ids.push(card.getAttribute('data-news-id'));
                    card.classList.add('read');
                });
                localStorage.setItem('news_read', JSON.stringify(ids));
                btn.style.display = 'none';
                var badge = document.getElementById('news-badge');
                if (badge) badge.style.display = 'none';
            });
        }
    } catch (e) {}
})();
</script>
{% endblock %}
