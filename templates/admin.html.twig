{% extends 'base.html.twig' %}

{% block title %}Адмін панель{% endblock %}

{% block body %}
<div class="w-full max-w-600 mx-auto p-4">
    <div class="flex items-center justify-between mb-6 pb-3 border-b-2 border-border">
        <h1 class="text-3xl font-bold m-0 font-unbounded tracking-tight uppercase">Адмін панель</h1>
        <div class="w-11 h-11 rounded bg-surface border-2 border-border shadow-brutal-sm flex items-center justify-center text-primary">
            <i data-lucide="shield" class="w-6 h-6 stroke-2-5"></i>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="bg-surface border-2 border-border rounded p-4 text-center shadow-brutal">
            <div class="flex justify-center items-center text-2xl font-bold mb-1 font-unbounded tracking-tight uppercase text-primary">{{ stats.total_users }}</div>
            <div class="text-[12px] text-muted font-bold uppercase">Користувачі</div>
        </div>
        <div class="bg-surface border-2 border-border rounded p-4 text-center shadow-brutal">
            <div class="flex justify-center items-center text-2xl font-bold mb-1 font-unbounded tracking-tight uppercase text-primary">{{ stats.total_admins }}</div>
            <div class="text-[12px] text-muted font-bold uppercase">Адміни</div>
        </div>
        <div class="bg-surface border-2 border-border rounded p-4 text-center shadow-brutal">
            <div class="flex justify-center items-center text-2xl font-bold mb-1 font-unbounded tracking-tight uppercase text-primary">{{ stats.pending_reports }}</div>
            <div class="text-[12px] text-muted font-bold uppercase">Очікують</div>
        </div>
        <div class="bg-surface border-2 border-border rounded p-4 text-center shadow-brutal">
            <div class="flex justify-center items-center text-2xl font-bold mb-1 font-unbounded tracking-tight uppercase text-primary">{{ stats.total_reports }}</div>
            <div class="text-[12px] text-muted font-bold uppercase">Репортів</div>
        </div>
    </div>

    <div class="flex gap-3 mb-6">
        <a href="{{ path('miniapp_reports') }}" class="flex-1 flex items-center justify-center gap-2 bg-border text-surface py-3 px-4 rounded font-bold text-[13px] uppercase font-unbounded border-2 border-border shadow-btn transition-all active:translate-brutal-sm active:shadow-xs no-underline">
            <i data-lucide="flag" class="w-5 h-5 stroke-2-5"></i>Черга
        </a>
        <a href="{{ path('miniapp_ranks') }}" class="flex-1 flex items-center justify-center gap-2 bg-surface text-primary py-3 px-4 rounded font-bold text-[13px] uppercase font-unbounded border-2 border-border shadow-brutal-sm transition-all active:translate-brutal-sm active:shadow-xs no-underline">
            <i data-lucide="award" class="w-5 h-5 stroke-2-5"></i>Ранги
        </a>
    </div>

    <h2 class="text-xl font-bold mb-4 text-primary border-b-2 border-border pb-2 font-unbounded tracking-tight uppercase">Адміністратори</h2>

    <div class="space-y-3">
        {% for admin in admins %}
            {% set rank_icon = admin.rank == 'owner' ? 'crown' : (admin.rank == 'admin' ? 'shield' : 'wrench') %}
            <div class="flex items-center p-3 bg-surface rounded border-2 border-border shadow-brutal-sm">
                <div class="w-11 h-11 rounded bg-surface flex items-center justify-center text-primary mr-3 shrink-0 border-2 border-border shadow-brutal-sm">
                    <i data-lucide="{{ rank_icon }}" class="w-6 h-6 stroke-2"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="font-bold text-[15px] text-primary font-unbounded tracking-tight uppercase truncate">{{ admin.first_name|default(admin.username|default(admin.user_id)) }}</div>
                    <div class="text-[12px] text-muted font-semibold">@{{ admin.username|default('—') }} · {{ admin.rank }}</div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
