{% extends 'base.html.twig' %}

{% block title %}Адмін панель{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Адмін панель</h1>
        <div class="header-icon"><i data-lucide="shield"></i></div>
    </div>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-value">{{ stats.total_users }}</div>
            <div class="stat-label">Користувачі</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">{{ stats.total_admins }}</div>
            <div class="stat-label">Адміни</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">{{ stats.pending_reports }}</div>
            <div class="stat-label">Очікують</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">{{ stats.total_reports }}</div>
            <div class="stat-label">Репортів</div>
        </div>
    </div>

    <div class="btn-row">
        <a href="{{ path('miniapp_reports') }}" class="btn btn-ghost">
            <i data-lucide="flag" class="icon-sm"></i>Репорти
        </a>
        <a href="{{ path('miniapp_ranks') }}" class="btn btn-ghost">
            <i data-lucide="award" class="icon-sm"></i>Ранги
        </a>
    </div>

    <h2 class="section-title">Адміністратори</h2>

    <div class="space-y">
        {% for admin in admins %}
            {% set rank_icon = admin.rank == 'owner' ? 'crown' : (admin.rank == 'admin' ? 'shield' : 'wrench') %}
            <div class="list-item">
                <div class="item-icon"><i data-lucide="{{ rank_icon }}"></i></div>
                <div class="item-body">
                    <div class="item-title">{{ admin.first_name|default(admin.username|default(admin.user_id)) }}</div>
                    <div class="item-sub">@{{ admin.username|default('—') }} · {{ admin.rank }}</div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
