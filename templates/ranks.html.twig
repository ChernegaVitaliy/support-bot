{% extends 'base.html.twig' %}

{% block title %}Керування рангами{% endblock %}

{% block body %}
    <a href="{{ path('miniapp_admin') }}" class="back-link hide-on-tma">
        <i data-lucide="arrow-left" class="icon-sm"></i> Адмін
    </a>

    <div class="page-header">
        <h1 class="page-title">Ранги</h1>
    </div>

    {% if can_set_rank %}
        <h2 class="section-title">Змінити ранг</h2>
        <div class="card">
            <form method="post" action="{{ path('miniapp_ranks') }}" class="form-inline">
                <input type="hidden" name="action" value="set_rank" />
                <input type="text" name="identifier" required placeholder="@username або ID" class="input" />
                <select name="rank" class="select">
                    <option value="moderator">moderator</option>
                    <option value="admin">admin</option>
                    <option value="owner">owner</option>
                </select>
                <button type="submit" class="btn btn-primary">OK</button>
            </form>
        </div>
    {% endif %}

    <h2 class="section-title">Список адмінів</h2>

    <div class="space-y">
        {% for admin in admins %}
            {% set rank_icon = admin.rank == 'owner' ? 'crown' : (admin.rank == 'admin' ? 'shield' : 'wrench') %}
            {% set is_default_owner = admin.user_id == default_owner_id %}
            <div class="list-item">
                <div class="item-icon"><i data-lucide="{{ rank_icon }}"></i></div>
                <div class="item-body">
                    <div class="item-title">{{ admin.first_name|default(admin.username|default(admin.user_id)) }}</div>
                    <div class="item-sub">@{{ admin.username|default('—') }} · {{ admin.rank }}</div>
                </div>

                {% if can_remove and not is_default_owner and admin.user_id != app_user_id %}
                    <form method="post" action="{{ path('miniapp_ranks') }}" onsubmit="return confirm('Видалити адміністратора?');">
                        <input type="hidden" name="action" value="remove" />
                        <input type="hidden" name="identifier" value="{{ admin.user_id }}" />
                        <button type="submit" class="btn btn-danger btn-icon"><i data-lucide="user-x" class="icon-sm"></i></button>
                    </form>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {% if not can_set_rank %}
        <p class="field-hint">Лише власник може змінювати ранги.</p>
    {% endif %}
{% endblock %}
