{% extends 'base.html.twig' %}

{% block title %}Репорт #{{ report.id }}{% endblock %}

{% block body %}
<div class="w-full max-w-600 mx-auto p-4">
    <a href="{{ path('miniapp_reports') }}" class="flex items-center gap-2 mb-4 text-primary font-bold uppercase font-unbounded tracking-tight no-underline text-[14px] active:opacity-80">
        <i data-lucide="arrow-left" class="w-5 h-5 stroke-2-5"></i> Репорти
    </a>

    <div class="bg-surface border-2 border-border rounded p-4 shadow-brutal mb-4">
        <div class="flex items-center justify-between mb-4 pb-3 border-b-2 border-border">
            <div class="flex items-center gap-2 font-bold text-2xl text-primary font-unbounded tracking-tight uppercase">
                <i data-lucide="hash" class="w-6 h-6 stroke-2-5"></i>{{ report.id }}
            </div>
            {% import 'macros.html.twig' as m %}
            {{ m.statusBadge(report.status) }}
        </div>

        <div class="space-y-3 text-[14px] font-semibold leading-relaxed">
            <div><span class="text-muted uppercase text-[12px]">Скаржник:</span> <code class="bg-black-5 px-1 rounded">{{ report.reporter_nick }}</code></div>
            <div><span class="text-muted uppercase text-[12px]">Порушник:</span> <code class="bg-black-5 px-1 rounded">{{ report.reported_nick }}</code></div>
            <div><span class="text-muted uppercase text-[12px]">Причина:</span> {{ report.reason }}</div>
            <div><span class="text-muted uppercase text-[12px]">Створено:</span> {{ report.created_at|date('d.m.Y H:i') }}</div>
        </div>

        {% if report.proof_type == 'text' and report.proof %}
            <div class="mt-4 p-3 bg-background border-2 border-border rounded text-[14px] font-semibold leading-relaxed">
                <span class="block text-[12px] text-muted font-bold uppercase mb-1">Докази</span>
                {{ report.proof }}
            </div>
        {% endif %}

        {% if media_files %}
            <div class="mt-4">
                <span class="block text-[12px] text-muted font-bold uppercase mb-2">Медіа</span>
                <div class="grid grid-cols-2 gap-3">
                    {% for item in media_files %}
                        {% set media_url = path('miniapp_media', {file: item.file_id, initData: init_data}) %}
                        {% if item.type == 'photo' or item.type == 'document' %}
                            <img src="{{ media_url }}" alt="proof" class="w-full aspect-square object-cover rounded border-2 border-border bg-background" loading="lazy" />
                        {% elseif item.type == 'video' or item.type == 'animation' %}
                            <video src="{{ media_url }}" controls class="w-full aspect-square object-cover rounded border-2 border-border bg-background"></video>
                        {% else %}
                            <a href="{{ media_url }}" class="flex items-center justify-center gap-2 p-3 bg-background border-2 border-border rounded text-primary font-bold no-underline" target="_blank" rel="noopener">
                                <i data-lucide="paperclip" class="w-5 h-5 stroke-2-5"></i> Відкрити файл
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if report.admin_notes %}
            <div class="mt-4 p-3 bg-black-5 border-2 border-border rounded text-[14px] font-semibold leading-relaxed">
                <span class="block text-[12px] text-muted font-bold uppercase mb-1">Коментар адміністрації</span>
                {{ report.admin_notes }}
            </div>
        {% endif %}

        {% if report.processed_by %}
            <div class="mt-3 text-[12px] text-muted font-semibold">
                Обробив: <code class="bg-black-5 px-1 rounded">{{ report.processed_by }}</code>
                {% if report.processed_at %} · {{ report.processed_at|date('d.m.Y H:i') }}{% endif %}
            </div>
        {% endif %}
    </div>

    {% if can_process %}
        <form method="post" action="{{ path('miniapp_report_process', {id: report.id}) }}" class="bg-surface border-2 border-border rounded p-4 shadow-brutal">
            <label class="block mb-3">
                <span class="block text-[12px] text-muted font-bold uppercase mb-2">Коментар (необовʼязково)</span>
                <textarea name="admin_notes" rows="2" class="w-full bg-background border-2 border-border rounded p-3 text-[15px] font-semibold text-primary focus:bg-white outline-none resize-none"></textarea>
            </label>
            <input type="hidden" name="action" value="accept" id="process-action" />
            <div class="flex gap-3">
                <button type="submit" onclick="document.getElementById('process-action').value='accept'"
                    class="flex-1 bg-border text-surface py-3 px-4 rounded font-bold text-[14px] uppercase flex items-center justify-center cursor-pointer border-2 border-border shadow-btn transition-all font-unbounded active:translate-brutal-sm active:shadow-xs">
                    <i data-lucide="check" class="mr-2 w-[18px] h-[18px] stroke-2-5"></i>Прийняти
                </button>
                <button type="submit" onclick="document.getElementById('process-action').value='reject'"
                    class="flex-1 bg-surface text-danger py-3 px-4 rounded font-bold text-[14px] uppercase flex items-center justify-center cursor-pointer border-2 border-border shadow-brutal-sm transition-all font-unbounded active:translate-brutal-sm active:shadow-xs">
                    <i data-lucide="x" class="mr-2 w-[18px] h-[18px] stroke-2-5"></i>Відхилити
                </button>
            </div>
        </form>
    {% endif %}
</div>
{% endblock %}
