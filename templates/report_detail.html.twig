{% extends 'base.html.twig' %}

{% block title %}Репорт #{{ report.id }}{% endblock %}

{% block body %}
    <a href="{{ path('miniapp_reports') }}" class="back-link hide-on-tma">
        <i data-lucide="arrow-left" class="icon-sm"></i> Репорти
    </a>

    <div class="card">
        <div class="report-head">
            <div class="report-id">
                <i data-lucide="hash" class="icon-sm"></i>{{ report.id }}
            </div>
            {% import 'macros.html.twig' as m %}
            {{ m.statusBadge(report.status) }}
        </div>

        <div class="detail-list">
            <div class="detail-row"><span class="muted-label">Скаржник:</span> <code class="code">{{ report.reporter_nick }}</code></div>
            <div class="detail-row"><span class="muted-label">Порушник:</span> <code class="code">{{ report.reported_nick }}</code></div>
            <div class="detail-row"><span class="muted-label">Причина:</span> {{ report.reason }}</div>
            <div class="detail-row"><span class="muted-label">Створено:</span> <time data-utc="{{ report.created_at|date('c') }}">{{ report.created_at|date('d.m.Y H:i') }}</time></div>
        </div>

        {% if report.proof_type == 'text' and report.proof %}
            <div class="note-box">
                <span class="muted-label">Докази</span>
                {{ report.proof }}
            </div>
        {% endif %}

        {% if media_files %}
            <div class="mt-16">
                <span class="muted-label">Медіа</span>
                <div class="media-grid">
                    {% for item in media_files %}
                        {% set media_url = path('miniapp_media', {file: item.file_id}) %}
                        {% if item.type == 'photo' or item.type == 'document' %}
                            <img src="{{ media_url }}" alt="proof" loading="lazy" />
                        {% elseif item.type == 'video' or item.type == 'animation' %}
                            <video src="{{ media_url }}" controls></video>
                        {% else %}
                            <a href="{{ media_url }}" class="btn btn-ghost" target="_blank" rel="noopener">
                                <i data-lucide="paperclip" class="icon-sm"></i> Відкрити файл
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if report.admin_notes %}
            <div class="note-box">
                <span class="muted-label">Коментар адміністрації</span>
                {{ report.admin_notes }}
            </div>
        {% endif %}

        {% if report.processed_by %}
            <div class="detail-row mt-16">Обробив: <code class="code">{{ report.processed_by }}</code>
                {% if report.processed_at %} · <time data-utc="{{ report.processed_at|date('c') }}">{{ report.processed_at|date('d.m.Y H:i') }}</time>{% endif %}
            </div>
        {% endif %}
    </div>

    {% if can_process %}
        <form method="post" action="{{ path('miniapp_report_process', {id: report.id}) }}" class="card">
            <label class="field">
                <span class="field-label">Коментар (необовʼязково)</span>
                <textarea name="admin_notes" rows="2" class="textarea"></textarea>
            </label>
            <input type="hidden" name="action" value="accept" id="process-action" />
            <div class="btn-row">
                <button type="submit" onclick="document.getElementById('process-action').value='accept'"
                    class="btn btn-primary"><i data-lucide="check" class="icon-sm"></i>Прийняти</button>
                <button type="submit" onclick="document.getElementById('process-action').value='reject'"
                    class="btn btn-danger"><i data-lucide="x" class="icon-sm"></i>Відхилити</button>
            </div>
        </form>
    {% endif %}
{% endblock %}
