{% extends 'base.html.twig' %}

{% block title %}Репорти{% endblock %}

{% block body %}
    <a href="{{ path('miniapp_admin') }}" class="back-link hide-on-tma">
        <i data-lucide="arrow-left" class="icon-sm"></i> Адмін
    </a>

    <div class="page-header">
        <h1 class="page-title">Репорти</h1>
    </div>

    <div class="filters">
        {% set filters = [
            {'key': 'pending', 'label': 'Очікують', 'count': counts.pending},
            {'key': 'accepted', 'label': 'Прийнято', 'count': counts.accepted},
            {'key': 'rejected', 'label': 'Відхилено', 'count': counts.rejected},
            {'key': 'all', 'label': 'Усі', 'count': counts.all}
        ] %}
        {% for f in filters %}
            <a href="{{ path('miniapp_reports', {status: f.key}) }}"
                class="filter-chip{% if status == f.key %} active{% endif %}">
                {{ f.label }} <span class="count">{{ f.count }}</span>
            </a>
        {% endfor %}
    </div>

    {% import 'macros.html.twig' as m %}
    {% for report in reports %}
        {{ m.reportCard(report, true, path('miniapp_report_detail', {id: report.id})) }}
    {% else %}
        <div class="empty">
            <i data-lucide="inbox"></i>
            <div class="empty-text">Пусто</div>
        </div>
    {% endfor %}

    {% if total_pages > 1 %}
        <div class="pagination">
            {% if page > 1 %}
                <a href="{{ path('miniapp_reports', {status: status, page: page - 1}) }}" class="btn btn-ghost btn-icon">
                    <i data-lucide="chevron-left" class="icon-sm"></i> Назад
                </a>
            {% else %}
                <span></span>
            {% endif %}
            <span class="page-info">{{ page }}/{{ total_pages }}</span>
            {% if page < total_pages %}
                <a href="{{ path('miniapp_reports', {status: status, page: page + 1}) }}" class="btn btn-ghost btn-icon">
                    Далі <i data-lucide="chevron-right" class="icon-sm"></i>
                </a>
            {% else %}
                <span></span>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
