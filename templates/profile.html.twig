{% extends 'base.html.twig' %}

{% block title %}Профіль{% endblock %}

{% block body %}
<div class="w-full max-w-600 mx-auto p-4">
    <div class="flex items-center justify-between mb-6 pb-3 border-b-2 border-border">
        <h1 class="text-3xl font-bold m-0 font-unbounded tracking-tight uppercase">Профіль</h1>
    </div>

    <div class="text-center py-8 px-4 mb-8 bg-surface rounded border-2 border-border shadow-brutal">
        <div class="w-22 h-22 mx-auto mb-5 rounded bg-surface flex items-center justify-center text-primary border-2 border-border shadow-brutal overflow-hidden shrink-0">
            <i data-lucide="user" class="w-12 h-12 stroke-1-5"></i>
        </div>
        <h2 class="text-[26px] font-bold mb-2 m-0 font-unbounded tracking-tight uppercase">{{ app_user.first_name|default(app_user.username|default('Користувач')) }}</h2>
        <div class="text-base text-primary mb-6 leading-relaxed font-semibold">@{{ app_user.username|default('—') }}</div>

        <span class="bg-border text-surface py-0-5 px-2 rounded text-xs font-bold uppercase font-unbounded inline-block">
            {% if is_admin %}
                {% if rank == 'owner' %}Власник
                {% elseif rank == 'admin' %}Адміністратор
                {% else %}Модератор{% endif %}
            {% else %}
                Користувач
            {% endif %}
        </span>
    </div>

    <h2 class="text-xl font-bold mb-5 text-primary border-b-2 border-border pb-2 font-unbounded tracking-tight uppercase">Статистика</h2>
    <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="bg-surface border-2 border-border rounded p-4 text-center shadow-brutal">
            <div class="flex justify-center items-center text-2xl font-bold mb-1 font-unbounded tracking-tight uppercase text-primary">{{ my_report_count }}</div>
            <div class="text-[12px] text-muted font-bold uppercase">Мої репорти</div>
        </div>
        <div class="bg-surface border-2 border-border rounded p-4 text-center shadow-brutal">
            <div class="flex justify-center items-center text-2xl font-bold mb-1 font-unbounded tracking-tight uppercase text-primary">ID: {{ app_user_id }}</div>
            <div class="text-[12px] text-muted font-bold uppercase">Ваш ID</div>
        </div>
    </div>

    <div class="flex items-center p-4 bg-surface rounded border-2 border-border mb-4 transition-all shadow-brutal">
        <div class="w-12 h-12 rounded bg-surface flex items-center justify-center text-primary mr-4 shrink-0 border-2 border-border shadow-brutal-sm">
            <i data-lucide="calendar" class="w-6 h-6 stroke-2"></i>
        </div>
        <div class="flex-1">
            <div class="flex items-center text-lg font-bold mb-1 font-unbounded tracking-tight uppercase">Приєднався</div>
            <div class="text-[14px] text-primary mb-1 leading-normal font-semibold">{{ db_user.created_at is defined and db_user.created_at ? db_user.created_at|date('d.m.Y') : 'Невідомо' }}</div>
        </div>
    </div>

    <a href="{{ path('miniapp_report_new') }}" class="flex items-center p-4 bg-surface rounded border-2 border-border mb-4 cursor-pointer transition-all shadow-brutal active:translate-brutal active:shadow-none no-underline text-inherit">
        <div class="w-12 h-12 rounded bg-surface flex items-center justify-center text-primary mr-4 shrink-0 border-2 border-border shadow-brutal-sm">
            <i data-lucide="plus-circle" class="w-6 h-6 stroke-2"></i>
        </div>
        <div class="flex-1">
            <div class="flex items-center text-lg font-bold mb-1 font-unbounded tracking-tight uppercase">Створити репорт</div>
            <div class="text-[14px] text-primary mb-1 leading-normal font-semibold">Поскаржитися на порушення</div>
        </div>
        <i data-lucide="chevron-right" class="text-muted w-6 h-6 stroke-2"></i>
    </a>
</div>
{% endblock %}
