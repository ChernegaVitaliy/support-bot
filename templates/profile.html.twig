{% extends 'base.html.twig' %}

{% block title %}Профіль{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Профіль</h1>
    </div>

    <div class="hero">
        <div class="hero-avatar">
            {% if app_user.photo_url is defined and app_user.photo_url %}
                <img src="{{ app_user.photo_url }}" alt="" />
            {% else %}
                <i data-lucide="user"></i>
            {% endif %}
        </div>
        <h2 class="hero-name">{{ app_user.first_name|default(app_user.username|default('Користувач')) }}</h2>
        <div class="hero-username">@{{ app_user.username|default('—') }}</div>

        <span class="pill">
            {% if is_admin %}
                {% if rank == 'owner' %}Власник
                {% elseif rank == 'admin' %}Адміністратор
                {% else %}Модератор{% endif %}
            {% else %}
                Користувач
            {% endif %}
        </span>
    </div>

    <h2 class="section-title">Статистика</h2>
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-value">{{ my_report_count }}</div>
            <div class="stat-label">Мої репорти</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">{{ app_user_id }}</div>
            <div class="stat-label">Ваш ID</div>
        </div>
    </div>

    <div class="list-item">
        <div class="item-icon"><i data-lucide="calendar"></i></div>
        <div class="item-body">
            <div class="item-title">Приєднався</div>
            <div class="item-sub">{% if db_user.created_at is defined and db_user.created_at %}<time data-utc="{{ db_user.created_at|date('c') }}" data-date-format="date">{{ db_user.created_at|date('d.m.Y') }}</time>{% else %}Невідомо{% endif %}</div>
        </div>
    </div>

    <a href="{{ path('miniapp_report_new') }}" class="list-item">
        <div class="item-icon"><i data-lucide="plus-circle"></i></div>
        <div class="item-body">
            <div class="item-title">Створити репорт</div>
            <div class="item-sub">Поскаржитися на порушення</div>
        </div>
        <i data-lucide="chevron-right" class="item-chevron icon-sm"></i>
    </a>
{% endblock %}
