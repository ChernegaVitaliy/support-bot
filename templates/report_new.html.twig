{% extends 'base.html.twig' %}

{% block title %}Створити репорт{% endblock %}

{% block body %}
    <a href="{{ path('miniapp_index') }}" class="back-link">
        <i data-lucide="arrow-left" class="icon-sm"></i> Назад
    </a>

    <div class="page-header">
        <h1 class="page-title">Новий репорт</h1>
    </div>

    <form method="post" action="{{ path('miniapp_report_new') }}" class="card">
        <label class="field">
            <span class="field-label">Ваш нік</span>
            <input type="text" name="reporter_nick" value="{{ values.reporter_nick|default('') }}" required class="input" placeholder="@username" />
        </label>

        <label class="field">
            <span class="field-label">Нік порушника</span>
            <input type="text" name="reported_nick" value="{{ values.reported_nick|default('') }}" required class="input" placeholder="@username" />
        </label>

        <label class="field">
            <span class="field-label">Причина</span>
            <input type="text" name="reason" value="{{ values.reason|default('') }}" required class="input" placeholder="Чітерство, токсична поведінка..." />
        </label>

        <label class="field">
            <span class="field-label">Докази (необовʼязково)</span>
            <textarea name="proof" rows="4" class="textarea">{{ values.proof|default('') }}</textarea>
            <span class="field-hint">Медіа-файли можна додати через бота командою /report.</span>
        </label>

        <button type="submit" class="btn btn-primary btn-block">
            <i data-lucide="send" class="icon-sm"></i>Надіслати репорт
        </button>
    </form>
{% endblock %}
